---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  prevPost?: CollectionEntry<'blog'> | null;
  nextPost?: CollectionEntry<'blog'> | null;
};

const { title, description, pubDate, tags = [], prevPost, nextPost } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="page">

    <a href="/" class="back">back to all posts</a>

    <header class="post-header">
      <div class="post-meta">
        <FormattedDate date={pubDate} />
      </div>
      <h1 class="post-title">{title}</h1>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map(tag => <span class="post-tag">{tag}</span>)}
        </div>
      )}
    </header>

    <article class="post-body">
      <slot />
    </article>

    <div class="author-bio">
      <div class="author-avatar"></div>
      <div class="author-info">
        <div class="author-name">Patricia <span>·</span> author</div>
        <div class="author-desc">Analyst &amp; curious person based in Prague. I write about data, slow mornings, and the web.</div>
      </div>
    </div>

    {(prevPost || nextPost) && (
      <nav class="post-nav">
        {prevPost ? (
          <a href={`/blog/${prevPost.id}/`} class="post-nav-link prev">
            <span class="nav-label">← previous</span>
            <span class="nav-title">{prevPost.data.title}</span>
          </a>
        ) : <div />}
        {nextPost ? (
          <a href={`/blog/${nextPost.id}/`} class="post-nav-link next">
            <span class="nav-label">next →</span>
            <span class="nav-title">{nextPost.data.title}</span>
          </a>
        ) : <div />}
      </nav>
    )}

  </div>
</BaseLayout>

<style>
  .page {
    max-width: 600px;
    margin: 0 auto;
    padding: 56px 24px 100px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin-bottom: 52px;
    transition: color 0.15s;
  }
  .back::before {
    content: '←';
    color: var(--orange);
    transition: transform 0.15s;
  }
  .back:hover { color: var(--ink); }
  .back:hover::before { transform: translateX(-3px); }

  .post-header {
    margin-bottom: 44px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--rule);
  }

  .post-meta {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin-bottom: 18px;
  }

  .post-title {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 16px;
    font-family: var(--font);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .post-tag {
    font-family: var(--font);
    font-size: 9px;
    letter-spacing: 0.07em;
    color: var(--ink-muted);
    border: 1px solid var(--rule);
    padding: 3px 8px;
  }
  .post-tag::before { content: '#'; }

  /* Post body — targets rendered markdown via :global */
  .post-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .post-body :global(p) {
    font-size: 13px;
    line-height: 1.85;
    font-weight: 300;
    color: var(--ink);
  }

  .post-body :global(h2) {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    font-family: var(--font);
  }

  .post-body :global(h3) {
    font-size: 12px;
    font-weight: 500;
    color: var(--orange);
    letter-spacing: 0.04em;
    font-family: var(--font);
  }

  .post-body :global(a) {
    color: var(--orange);
    text-decoration: underline;
    text-decoration-color: var(--orange-border);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }
  .post-body :global(a:hover) { text-decoration-color: var(--orange); }

  .post-body :global(code) {
    font-family: var(--font);
    font-size: 11.5px;
    background: var(--code-bg);
    padding: 1px 5px;
    color: var(--ink);
  }

  .post-body :global(pre) {
    background: #1e1c1a;
    padding: 22px 24px;
    overflow-x: auto;
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: 11.5px;
    color: #c8c4be;
    line-height: 1.7;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 20px;
    font-weight: 300;
  }

  .post-body :global(li) { margin-bottom: 4px; }
  .post-body :global(li::marker) { color: var(--orange); }

  .post-body :global(mark) {
    background: oklch(0.63 0.19 47 / 0.4);
    color: inherit;
    padding: 0 2px;
  }

  .post-body :global(blockquote) {
    border-left: 2px solid var(--orange);
    padding: 14px 18px;
    background: var(--orange-pale);
  }

  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--rule);
  }

  .post-body :global(img) {
    max-width: 100%;
    border-radius: 0;
  }

  /* Author bio */
  .author-bio {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    align-items: start;
  }

  .author-avatar {
    width: 52px;
    height: 52px;
    background: repeating-linear-gradient(
      -45deg,
      #e8e6e2 0px, #e8e6e2 1px,
      #f0ede9 1px, #f0ede9 6px
    );
    flex-shrink: 0;
  }

  .author-name {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .author-name span { color: var(--orange); }

  .author-desc {
    font-size: 11.5px;
    font-weight: 300;
    color: var(--ink-muted);
    line-height: 1.6;
  }

  /* Prev / Next */
  .post-nav {
    margin-top: 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .post-nav-link {
    padding: 14px 16px;
    border: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 5px;
    transition: border-color 0.15s;
  }
  .post-nav-link:hover { border-color: var(--orange); }
  .post-nav-link.next { text-align: right; }

  .nav-label {
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .nav-title {
    font-size: 11.5px;
    font-weight: 400;
    color: var(--ink);
    line-height: 1.4;
  }
  .post-nav-link:hover .nav-title { color: var(--orange); }
</style>
