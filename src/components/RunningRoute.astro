// ---------------------------------------------------------------------------
// Path generation — traced from actual Strava route shape (400×400 viewBox)
// ---------------------------------------------------------------------------
const RAW_COORDS = (() => {
  // Natural loop trimmed from GPX: starts/ends at the left-side turn (~5px gap, closed invisibly)
  const wp = [
    [30.9,120.8],[32.5,114.1],[37.7,109.7],[43.0,105.4],[47.9,100.4],
    [52.9,95.6],[58.2,91.3],[63.5,87.0],[68.8,82.8],[74.1,78.4],
    [79.4,74.2],[84.6,69.8],[89.7,65.0],[94.4,59.6],[99.8,55.7],
    [105.4,52.3],[111.2,49.7],[116.8,46.2],[122.6,43.2],[128.5,41.2],
    [134.5,39.7],[140.5,37.7],[146.5,36.2],[152.6,34.8],[158.6,32.8],
    [164.4,30.1],[170.3,31.6],[176.2,33.5],[181.7,32.8],[187.6,34.8],
    [193.5,37.1],[199.4,39.6],[205.0,43.0],[210.6,46.3],[216.0,50.5],
    [221.3,54.5],[226.0,60.0],[231.4,63.8],[236.7,68.2],[240.9,74.4],
    [245.4,80.0],[249.7,85.8],[253.3,92.8],[256.7,99.8],[260.2,106.7],
    [263.4,114.0],[266.7,121.1],[269.8,128.4],[273.2,135.4],[276.8,142.1],
    [280.6,147.1],[285.0,141.1],[289.8,136.0],[294.8,131.1],[299.7,126.1],
    [304.5,120.9],[309.9,117.1],[315.9,118.5],[321.5,122.0],[326.4,127.1],
    [330.8,132.9],[335.6,138.1],[339.7,144.5],[344.1,150.3],[348.4,156.4],
    [352.0,163.2],[356.1,169.3],[360.8,174.8],[365.5,180.2],[369.5,186.5],
    [368.6,194.4],[366.6,202.4],[363.6,209.8],[359.8,213.6],[356.5,220.6],
    [352.3,226.9],[348.1,233.0],[343.0,237.7],[338.2,242.5],[334.4,249.2],
    [331.1,256.3],[328.0,263.5],[323.8,269.7],[319.3,275.5],[314.9,281.4],
    [310.7,287.5],[305.4,291.7],[300.6,296.9],[297.5,304.2],[294.4,311.3],
    [290.9,318.3],[287.0,324.8],[282.5,330.6],[278.3,336.7],[273.9,342.6],
    [269.5,348.5],[264.9,354.2],[260.4,359.7],[256.0,365.6],[250.9,369.9],
    [246.2,365.1],[240.2,366.3],[234.1,365.0],[229.5,359.8],[224.8,354.3],
    [220.3,348.6],[215.8,342.7],[211.8,336.4],[207.1,331.1],[201.2,328.6],
    [195.1,327.8],[189.7,331.1],[185.1,336.7],[180.1,341.5],[174.1,341.7],
    [168.8,337.6],[164.7,331.4],[160.4,325.3],[155.9,319.6],[151.7,313.4],
    [147.7,307.1],[144.1,300.2],[141.3,292.7],[137.7,285.9],[133.5,279.7],
    [131.3,272.2],[127.4,265.7],[123.1,259.7],[118.8,253.6],[114.5,247.6],
    [110.8,241.0],[106.4,235.1],[101.7,229.7],[97.7,223.3],[92.8,218.2],
    [87.8,213.3],[83.4,207.4],[79.3,201.2],[75.3,194.7],[72.3,187.3],
    [69.1,180.2],[65.5,173.3],[61.3,167.2],[57.2,160.9],[53.3,154.4],
    [49.2,148.1],[44.7,142.3],[40.8,135.8],[36.8,129.4],[32.5,123.4],
    [31.2,115.9],
  ];

  // Cumulative arc lengths along the polyline
  const segLens = [];
  let total = 0;
  for (let i = 1; i < wp.length; i++) {
    const d = Math.hypot(wp[i][0] - wp[i-1][0], wp[i][1] - wp[i-1][1]);
    segLens.push(d);
    total += d;
  }

  // Sample RUNS.length evenly-spaced points — one per run, no gaps possible
  const N = RUNS.length;
  const pts = [];
  for (let i = 0; i < N; i++) {
    const target = (i / N) * total;
    let acc = 0;
    for (let s = 0; s < segLens.length; s++) {
      if (acc + segLens[s] >= target || s === segLens.length - 1) {
        const t = segLens[s] > 0 ? Math.min(1, (target - acc) / segLens[s]) : 0;
        const a = wp[s], b = wp[s + 1];
        pts.push([a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])]);
        break;
      }
      acc += segLens[s];
    }
  }
  // Flatten slightly: stretch x by 1.15× from centre
  return pts.map(([x, y]) => [200 + (x - 200) * 1.3, y]);
})();

const N = RAW_COORDS.length;
const TOTAL_KM = RUNS.reduce((s, r) => s + r.km, 0);

// Map each run to an evenly-spaced index along the path
const rScale = d3.scaleLinear([2, 21], [2.875, 10.35]).clamp(true);
const runBubbles = RUNS.map((run, i) => {
  const pathIdx = i;
  const [x, y] = RAW_COORDS[pathIdx];
  return { ...run, x, y, r: rScale(run.km), pathIdx };
});

// ---------------------------------------------------------------------------
// D3 setup
// ---------------------------------------------------------------------------
const svg = d3.select('#route-svg');
const tooltip = document.getElementById('run-tooltip');
const svgWrap = document.querySelector('.route-svg-wrap');

// Ghost outline
const lineGen = d3.line().x(d => d[0]).y(d => d[1]).curve(d3.curveCatmullRomClosed.alpha(0.5));
svg.append('path')
  .datum(RAW_COORDS)
  .attr('d', lineGen)
  .attr('fill', 'none')
  .attr('stroke', '#e2dfd9')
  .attr('stroke-width', 1)
  .attr('stroke-dasharray', '2 5');

// Start ring
svg.append('circle')
  .attr('cx', RAW_COORDS[0][0])
  .attr('cy', RAW_COORDS[0][1])
  .attr('r', 5)
  .attr('fill', 'none')
  .attr('stroke', 'oklch(0.63 0.19 47)')
  .attr('stroke-width', 1.5)
  .attr('opacity', 0.4);

svg.append('text')
  .attr('x', RAW_COORDS[0][0] + 10)
  .attr('y', RAW_COORDS[0][1] + 4)
  .attr('font-family', '"IBM Plex Mono", monospace')
  .attr('font-size', '8px')
  .attr('letter-spacing', '0.06em')
  .attr('fill', '#b8b4ae')
  .text('first run');

// Run bubbles — revealed by scroll, hoverable
const bubbles = svg.selectAll('circle.run-bubble')
  .data(runBubbles)
  .enter()
  .append('circle')
  .attr('class', 'run-bubble')
  .attr('cx', d => d.x)
  .attr('cy', d => d.y)
  .attr('r', d => d.r)
  .attr('fill', 'oklch(0.63 0.19 47)')
  .attr('fill-opacity', 0.75)
  .attr('opacity', 0)
  .attr('cursor', 'pointer')
  .on('mouseenter', function(event, d) {
    d3.select(this)
      .transition().duration(80)
      .attr('fill', 'oklch(0.45 0.19 47)')
      .attr('fill-opacity', 0.85)
      .attr('r', d.r + 1.5);

    const tipDate = tooltip.querySelector('.tip-date');
    const tipName = tooltip.querySelector('.tip-name');
    const tipKm   = tooltip.querySelector('.tip-km');
    tipDate.textContent = d.date;
    tipName.textContent = d.name;
    tipKm.textContent   = d.km.toFixed(2) + ' km';

    const rect = svgWrap.getBoundingClientRect();
    tooltip.style.left = (event.clientX - rect.left) + 'px';
    tooltip.style.top  = (event.clientY - rect.top)  + 'px';
    tooltip.classList.add('visible');
  })
  .on('mousemove', function(event) {
    const rect = svgWrap.getBoundingClientRect();
    tooltip.style.left = (event.clientX - rect.left) + 'px';
    tooltip.style.top  = (event.clientY - rect.top)  + 'px';
  })
  .on('mouseleave', function(event, d) {
    d3.select(this)
      .transition().duration(120)
      .attr('fill', 'oklch(0.63 0.19 47)')
      .attr('fill-opacity', 0.75)
      .attr('r', d.r);
    tooltip.classList.remove('visible');
  });

// Moving head dot
const headDot = svg.append('circle')
  .attr('class', 'head-dot')
  .attr('r', 5)
  .attr('fill', 'oklch(0.63 0.19 47)')
  .attr('opacity', 0);

// ---------------------------------------------------------------------------
// Scroll logic
// ---------------------------------------------------------------------------
const section    = document.getElementById('route-section');
const distEl     = document.getElementById('route-dist');
const hintEl     = document.getElementById('route-hint');
const completeEl = document.getElementById('route-complete');

completeEl.textContent = `${RUNS.length} runs · ${TOTAL_KM.toFixed(0)} km`;

let raf = null;
let lastProgress = -1;

function getProgress() {
  const rect = section.getBoundingClientRect();
  const h    = section.offsetHeight;
  const win  = window.innerHeight;
  return Math.max(0, Math.min(1, -rect.top / (h - win)));
}

function render() {
  raf = null;
  const p = getProgress();
  if (Math.abs(p - lastProgress) < 0.002) return;
  lastProgress = p;

  const visiblePathIdx = Math.floor(p * N);

  // Reveal bubbles in chronological order
  bubbles.attr('opacity', d => (d.pathIdx <= visiblePathIdx ? 1 : 0));

  // Head dot
  if (p > 0 && p < 0.99) {
    const idx = Math.min(visiblePathIdx, N - 1);
    headDot
      .attr('cx', RAW_COORDS[idx][0])
      .attr('cy', RAW_COORDS[idx][1])
      .attr('opacity', 1);
  } else {
    headDot.attr('opacity', 0);
  }

  // Run counter
  const visibleCount = runBubbles.filter(d => d.pathIdx <= visiblePathIdx).length;
  distEl.textContent = visibleCount;

  // Hint fades once scrolling starts
  hintEl.style.opacity = p < 0.03 ? '1' : String(Math.max(0, 1 - p * 6));

  // Complete badge
  completeEl.style.opacity = p >= 0.98 ? '1' : '0';
}

function onScroll() {
  if (!raf) raf = requestAnimationFrame(render);
}

window.addEventListener('scroll', onScroll, { passive: true });
render();
</script>

<style>
  .route-section {
    height: 250vh;
    margin-top: 40px;
    margin-bottom: 40px;
    width: 85vw;
    margin-left: 50%;
    transform: translateX(-50%);
  }

  @media (max-width: 768px) {
    .route-section {
      width: calc(100% + 48px);
      margin-left: -24px;
      transform: none;
    }
  }

  .route-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .route-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .route-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 13px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .route-label { color: #b8b4ae; }

  .route-counter {
    color: #1a1917;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    min-width: 7ch;
    text-align: right;
  }

  .route-svg-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 80vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .route-footer {
    text-align: center;
    font-size: 9px;
    letter-spacing: 0.07em;
    min-height: 16px;
    position: relative;
  }

  .route-hint {
    color: #b8b4ae;
    transition: opacity 0.4s ease;
    display: block;
  }

  .route-complete {
    position: absolute;
    inset: 0;
    color: oklch(0.63 0.19 47);
    transition: opacity 0.6s ease;
    opacity: 0;
  }

  /* Tooltip */
  .run-tooltip {
    position: absolute;
    background: #1a1917;
    color: #faf9f7;
    font-family: "IBM Plex Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.06em;
    line-height: 1.7;
    padding: 6px 9px;
    border-radius: 2px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s ease;
    white-space: nowrap;
    transform: translate(-50%, calc(-100% - 12px));
    z-index: 10;
