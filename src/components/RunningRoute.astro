  { date: "May 4, 2026",  km: 9.00 },
];

// ---------------------------------------------------------------------------
// Path generation — same wiggly loop as original
// ---------------------------------------------------------------------------
const RAW_COORDS = (() => {
  const pts = [];
  const N = 120;
  for (let i = 0; i < N; i++) {
    const t = (i / N) * Math.PI * 2;
    const r = 150
      + 20 * Math.sin(5 * t + 0.4)
      + 11 * Math.cos(11 * t + 1.3)
      +  6 * Math.sin(19 * t + 2.2)
      +  3 * Math.cos(31 * t + 0.7);
    pts.push([200 + Math.cos(t) * r, 200 + Math.sin(t) * r]);
  }
  return pts;
})();

const N = RAW_COORDS.length;
const TOTAL_KM = RUNS.reduce((s, r) => s + r.km, 0);

// Map each run to an evenly-spaced index along the path
const rScale = d3.scaleLinear([2, 18], [2.5, 8]).clamp(true);
const runBubbles = RUNS.map((run, i) => {
  const pathIdx = Math.round((i / (RUNS.length - 1)) * (N - 1));
  const [x, y] = RAW_COORDS[pathIdx];
  return { ...run, x, y, r: rScale(run.km), pathIdx };
});

// ---------------------------------------------------------------------------
// D3 setup
// ---------------------------------------------------------------------------
const svg = d3.select('#route-svg');
const tooltip = document.getElementById('run-tooltip');
const svgWrap = document.querySelector('.route-svg-wrap');

// Ghost outline
const lineGen = d3.line().x(d => d[0]).y(d => d[1]).curve(d3.curveCatmullRomClosed.alpha(0.5));
svg.append('path')
  .datum(RAW_COORDS)
  .attr('d', lineGen)
  .attr('fill', 'none')
  .attr('stroke', '#e2dfd9')
  .attr('stroke-width', 1)
  .attr('stroke-dasharray', '2 5');

// Start ring
svg.append('circle')
  .attr('cx', RAW_COORDS[0][0])
  .attr('cy', RAW_COORDS[0][1])
  .attr('r', 5)
  .attr('fill', 'none')
  .attr('stroke', 'oklch(0.63 0.19 47)')
  .attr('stroke-width', 1.5)
  .attr('opacity', 0.4);

svg.append('text')
  .attr('x', RAW_COORDS[0][0] + 10)
  .attr('y', RAW_COORDS[0][1] + 4)
  .attr('font-family', '"IBM Plex Mono", monospace')
  .attr('font-size', '8px')
  .attr('letter-spacing', '0.06em')
  .attr('fill', '#b8b4ae')
  .text('first run');

// Run bubbles — revealed by scroll, hoverable
const bubbles = svg.selectAll('circle.run-bubble')
  .data(runBubbles)
  .enter()
  .append('circle')
  .attr('class', 'run-bubble')
  .attr('cx', d => d.x)
  .attr('cy', d => d.y)
  .attr('r', d => d.r)
  .attr('fill', 'oklch(0.63 0.19 47)')
  .attr('opacity', 0)
  .attr('cursor', 'pointer')
  .on('mouseenter', function(event, d) {
    d3.select(this)
      .transition().duration(80)
      .attr('fill', 'oklch(0.45 0.19 47)')
      .attr('r', d.r + 1.5);

    const tipDate = tooltip.querySelector('.tip-date');
    const tipKm   = tooltip.querySelector('.tip-km');
    tipDate.textContent = d.date;
    tipKm.textContent   = d.km.toFixed(2) + ' km';

    const rect = svgWrap.getBoundingClientRect();
    tooltip.style.left = (event.clientX - rect.left) + 'px';
    tooltip.style.top  = (event.clientY - rect.top)  + 'px';
    tooltip.classList.add('visible');
  })
  .on('mousemove', function(event) {
    const rect = svgWrap.getBoundingClientRect();
    tooltip.style.left = (event.clientX - rect.left) + 'px';
    tooltip.style.top  = (event.clientY - rect.top)  + 'px';
  })
  .on('mouseleave', function(event, d) {
    d3.select(this)
      .transition().duration(120)
      .attr('fill', 'oklch(0.63 0.19 47)')
      .attr('r', d.r);
    tooltip.classList.remove('visible');
  });

// Moving head dot
const headDot = svg.append('circle')
  .attr('class', 'head-dot')
  .attr('r', 5)
  .attr('fill', 'oklch(0.63 0.19 47)')
  .attr('opacity', 0);

// ---------------------------------------------------------------------------
// Scroll logic
// ---------------------------------------------------------------------------
const section    = document.getElementById('route-section');
const distEl     = document.getElementById('route-dist');
const hintEl     = document.getElementById('route-hint');
const completeEl = document.getElementById('route-complete');

completeEl.textContent = `${RUNS.length} runs · ${TOTAL_KM.toFixed(0)} km`;

let raf = null;
let lastProgress = -1;

function getProgress() {
  const rect = section.getBoundingClientRect();
  const h    = section.offsetHeight;
  const win  = window.innerHeight;
  return Math.max(0, Math.min(1, -rect.top / (h - win)));
}

function render() {
  raf = null;
  const p = getProgress();
  if (Math.abs(p - lastProgress) < 0.002) return;
  lastProgress = p;

  const visiblePathIdx = Math.floor(p * N);

  // Reveal bubbles in chronological order
  bubbles.attr('opacity', d => (d.pathIdx <= visiblePathIdx ? 0.85 : 0));

  // Head dot
  if (p > 0 && p < 0.99) {
    const idx = Math.min(visiblePathIdx, N - 1);
    headDot
      .attr('cx', RAW_COORDS[idx][0])
      .attr('cy', RAW_COORDS[idx][1])
      .attr('opacity', 1);
  } else {
    headDot.attr('opacity', 0);
  }

  // Run counter
  const visibleCount = runBubbles.filter(d => d.pathIdx <= visiblePathIdx).length;
  distEl.textContent = visibleCount;

  // Hint fades once scrolling starts
  hintEl.style.opacity = p < 0.03 ? '1' : String(Math.max(0, 1 - p * 6));

  // Complete badge
  completeEl.style.opacity = p >= 0.98 ? '1' : '0';
}

function onScroll() {
  if (!raf) raf = requestAnimationFrame(render);
}

window.addEventListener('scroll', onScroll, { passive: true });
render();
</script>

<style>
  .route-section {
    height: 200vh;
    margin-top: 20px;
    margin-bottom: 20px;
    width: 65vw;
    margin-left: 50%;
    transform: translateX(-50%);
  }

  @media (max-width: 768px) {
    .route-section {
      width: calc(100% + 48px);
      margin-left: -24px;
      transform: none;
    }
  }

  .route-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .route-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .route-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 9px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .route-label { color: #b8b4ae; }

  .route-counter {
    color: #1a1917;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    min-width: 7ch;
    text-align: right;
  }

  .route-svg-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 62vh;
    border: 1px solid #e2dfd9;
    background: #faf9f7;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .route-footer {
    text-align: center;
    font-size: 9px;
    letter-spacing: 0.07em;
    min-height: 16px;
    position: relative;
  }

  .route-hint {
    color: #b8b4ae;
    transition: opacity 0.4s ease;
    display: block;
  }

  .route-complete {
    position: absolute;
    inset: 0;
    color: oklch(0.63 0.19 47);
    transition: opacity 0.6s ease;
    opacity: 0;
  }

  /* Tooltip */
  .run-tooltip {
    position: absolute;
    background: #1a1917;
    color: #faf9f7;
    font-family: "IBM Plex Mono", monospace;
    font-size: 9px;
    letter-spacing: 0.06em;
    line-height: 1.7;
    padding: 6px 9px;
    border-radius: 2px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s ease;
    white-space: nowrap;
    transform: translate(-50%, calc(-100% - 12px));
    z-index: 10;
  }

  .run-tooltip.visible { opacity: 1; }

  .tip-date {
    display: block;
    color: #b8b4ae;
  }

  .tip-km {
    display: block;
    font-weight: 500;
  }

  /* SVG head dot pulse */
  :global(.head-dot) {
    animation: route-pulse 1.4s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes route-pulse {
    0%, 100% { transform: scale(1);   opacity: 1;   }
    50%       { transform: scale(2);   opacity: 0.3; }
  }
</style>
