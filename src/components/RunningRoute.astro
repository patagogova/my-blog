---

<section class="route-section" id="route-section" aria-label="Running log visualization">
  <div class="route-sticky">
    <div class="route-inner">

      <div class="route-header">
        <span class="route-label">all runs · may 2025 → now</span>
        <span class="route-counter"><span id="route-dist">0</span> runs</span>
      </div>

      <div class="route-svg-wrap">
        <svg
          id="route-svg"
          viewBox="0 0 400 400"
          width="100%"
          height="100%"
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
        ></svg>
        <div id="run-tooltip" class="run-tooltip">
          <span class="tip-date"></span>
          <span class="tip-name"></span>
          <span class="tip-km"></span>
        </div>
      </div>

      <div class="route-footer">
        <span id="route-hint" class="route-hint">↓ scroll to trace all runs</span>
        <span id="route-complete" class="route-complete"></span>
      </div>

    </div>
  </div>
</section>

