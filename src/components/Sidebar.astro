---
---

<aside class="sidebar">
  <div class="avatar">
    <!-- Replace with your actual photo: <img src="/photo.jpg" alt="Paťa" /> -->
    <svg viewBox="0 0 88 88" width="88" height="88" fill="none">
      <circle cx="44" cy="36" r="16" fill="var(--ink-faint)" opacity="0.5"/>
      <ellipse cx="44" cy="72" rx="26" ry="18" fill="var(--ink-faint)" opacity="0.35"/>
    </svg>
  </div>

  <div class="name-block">
    <div class="name">Paťa</div>
    <div class="tagline">analyst & curious person<br/>based in Prague</div>
  </div>

  <nav class="links">
    <a href="mailto:you@example.com">email</a>
    <a href="https://linkedin.com" target="_blank" rel="noopener">linkedin</a>
    <a href="https://instagram.com" target="_blank" rel="noopener">instagram</a>
    <a href="https://github.com" target="_blank" rel="noopener">github</a>
  </nav>
</aside>

<style>
  .sidebar {
    width: var(--sidebar-w);
    min-width: var(--sidebar-w);
    height: 100%;
    padding: 48px 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-right: 1.5px solid var(--border);
    background: var(--bg);
  }

  .avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: var(--bg-dim);
    border: 1.5px solid var(--border);
    overflow: hidden;
    flex-shrink: 0;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .name-block {
    margin-top: 20px;
  }

  .name {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 38px;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }

  .tagline {
    margin-top: 6px;
    font-family: 'Crimson Pro', serif;
    font-style: italic;
    font-size: 15px;
    color: var(--ink-mid);
    line-height: 1.4;
  }

  .links {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .links a {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    transition: color 0.15s;
  }

  .links a:hover {
    color: var(--accent);
  }
</style>
