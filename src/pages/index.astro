---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = [...new Set(posts.flatMap(p => p.data.tags ?? []))].sort();
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="site">
    <div class="columns">

      <!-- LEFT -->
      <aside class="left">
        <div class="photo-wrap">
          <div class="photo-placeholder"></div>
          <div class="name-block">
            <span class="first">Patricia</span>
          </div>
        </div>

        <p class="bio">
          Analyst &amp; curious person based in Prague.<br /><br />
          <em>I write about data, slow mornings, and the web.</em>
        </p>

        <nav class="left-nav">
          <a href="/about">About</a>
          <a href="/">Writing</a>
          <a href="mailto:you@example.com">Contact</a>
        </nav>
      </aside>

      <!-- RIGHT -->
      <main class="right">
        <div class="posts-header">writing</div>

        <div class="tag-filter" id="tagFilter">
          <button class="tag-btn all active" data-tag="all">all</button>
          {allTags.map(tag => (
            <button class="tag-btn" data-tag={tag}>{tag}</button>
          ))}
        </div>

        <div class="post-list" id="postList">
          {posts.map(post => (
            <a
              href={`/blog/${post.id}/`}
              class="post-item"
              data-tags={(post.data.tags ?? []).join(',')}
            >
              <span class="post-date">
                <FormattedDate date={post.data.pubDate} />
              </span>
              <div class="post-content">
                <div class="post-title">{post.data.title}</div>
                {(post.data.tags ?? []).length > 0 && (
                  <div class="post-tags">
                    {(post.data.tags ?? []).map(tag => (
                      <button class="post-tag" data-tag={tag}>{tag}</button>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>

        <p class="footer">built with astro</p>
      </main>

    </div>
  </div>
</BaseLayout>

<style>
  .site {
    max-width: 912px;
    margin: 0 auto;
    padding: 72px 24px 100px;
  }

  .columns {
    display: grid;
    grid-template-columns: 312px 1fr;
    gap: 72px;
    align-items: start;
  }

  /* LEFT */
  .left { position: sticky; top: 72px; }

  .photo-placeholder {
    width: 100%;
    aspect-ratio: 3/4;
    background: repeating-linear-gradient(
      -45deg,
      #e8e6e2 0px, #e8e6e2 1px,
      #f0ede9 1px, #f0ede9 9px
    );
  }

  .name-block {
    position: relative;
    margin-top: -28px;
    margin-left: -2px;
    z-index: 2;
    pointer-events: none;
  }

  .first {
    font-size: 36px;
    font-weight: 500;
    line-height: 1;
    color: var(--orange);
    letter-spacing: -0.02em;
    background: var(--bg);
    display: inline-block;
    padding: 2px 4px 0 0;
  }

  .bio {
    margin-top: 20px;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--ink);
    font-weight: 300;
  }

  .bio em {
    font-style: italic;
    color: var(--ink-muted);
  }

  .left-nav {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .left-nav a {
    font-size: 12px;
    font-weight: 400;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.15s;
  }

  .left-nav a::before {
    content: '→';
    color: var(--orange);
    font-size: 11px;
    transition: transform 0.15s;
  }

  .left-nav a:hover { color: var(--ink); }
  .left-nav a:hover::before { transform: translateX(3px); }

  /* RIGHT */
  .posts-header {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 28px;
  }

  .tag-btn {
    background: none;
    border: 1px solid #d8d5cf;
    font-family: var(--font);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    padding: 3px 9px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .tag-btn:hover,
  .tag-btn.active {
    border-color: var(--orange);
    color: var(--orange);
    background: var(--orange-pale);
  }

  .tag-btn.all.active {
    border-color: var(--ink);
    color: var(--ink);
    background: transparent;
  }

  /* Post list */
  .post-list { display: flex; flex-direction: column; }

  .post-item {
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    align-items: start;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  .post-item:first-child { border-top: 1px solid var(--rule); }
  .post-item.hidden { display: none; }
  .post-item:hover .post-title { color: var(--orange); }

  .post-date {
    font-size: 10px;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
    font-weight: 300;
    white-space: nowrap;
    padding-top: 2px;
  }

  .post-title {
    font-size: 13px;
    font-weight: 400;
    color: var(--ink);
    line-height: 1.4;
    transition: color 0.15s;
    margin-bottom: 6px;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .post-tag {
    font-size: 9px;
    letter-spacing: 0.07em;
    color: var(--ink-muted);
    background: none;
    border: none;
    font-family: var(--font);
    padding: 0;
    cursor: pointer;
    transition: color 0.15s;
  }

  .post-tag::before { content: '#'; }
  .post-tag:hover { color: var(--orange); }

  .footer {
    margin-top: 60px;
    font-size: 10px;
    color: var(--ink-muted);
    letter-spacing: 0.06em;
    opacity: 0.6;
  }

  @media (max-width: 720px) {
    .columns { grid-template-columns: 1fr; }
    .left { position: static; }
    .photo-placeholder { max-width: 200px; }
  }
</style>

<script>
  const filterEl = document.getElementById('tagFilter')!;
  const listEl = document.getElementById('postList')!;

  let active = 'all';

  function filter(tag: string) {
    active = tag;
    filterEl.querySelectorAll('.tag-btn').forEach(b => {
      (b as HTMLElement).classList.toggle('active', (b as HTMLElement).dataset.tag === tag);
    });
    listEl.querySelectorAll('.post-item').forEach(item => {
      const tags = (item as HTMLElement).dataset.tags?.split(',') ?? [];
      (item as HTMLElement).classList.toggle('hidden', tag !== 'all' && !tags.includes(tag));
    });
  }

  filterEl.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('.tag-btn') as HTMLElement | null;
    if (btn?.dataset.tag) filter(btn.dataset.tag);
  });

  listEl.addEventListener('click', e => {
    const tag = (e.target as HTMLElement).closest('.post-tag') as HTMLElement | null;
    if (tag?.dataset.tag) {
      e.preventDefault();
      filter(tag.dataset.tag);
    }
  });
</script>
